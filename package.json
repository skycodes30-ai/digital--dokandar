{
  "name": "shop-ledger-app",
  "version": "1.0.0",
  "private": true,
  "description": "Bangla-first local shop ledger and reminder app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug",
    "android:build:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "cors": "^2.8.6",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
